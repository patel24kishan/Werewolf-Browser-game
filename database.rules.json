{
  "rules": {
    "rooms": {
      "$code": {
        ".write": "auth != null && auth.uid === root.child('rooms/' + $code + '/meta/hostId').val()",
        ".validate": "$code.length === 4 && $code.matches(/^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]+$/) && newData.hasChild('meta')",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.child('hostId').val() === auth.uid && newData.child('status').val() === 'lobby'",
          ".validate": "newData.hasChildren(['hostId', 'hostMode', 'status', 'sheriffOn', 'createdAt'])",
          "hostId": {
            ".validate": "newData.isString() && newData.val().length <= 128 && newData.val().matches(/^[A-Za-z0-9_-]+$/) && (newData.val() === auth.uid || newData.parent().parent().child('players/' + newData.val()).exists())"
          },
          "hostMode": {
            ".validate": "newData.isString() && (newData.val() === 'moderating' || newData.val() === 'playing')"
          },
          "status": {
            ".validate": "newData.isString() && (newData.val() === 'lobby' || newData.val() === 'dealt' || newData.val() === 'night' || newData.val() === 'day' || newData.val() === 'over')"
          },
          "sheriffOn": {
            ".validate": "newData.isBoolean()"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "deck": {
          ".read": "auth != null",
          ".validate": "newData.hasChildren(['playerCount'])",
          "playerCount": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 5 && newData.val() <= 18"
          },
          "specialRoles": {
            "$i": {
              ".validate": "$i.length <= 2 && $i.matches(/^[0-9]+$/) && newData.isString() && (newData.val() === 'witch' || newData.val() === 'hunter' || newData.val() === 'cupid' || newData.val() === 'little-girl' || newData.val() === 'thief')"
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "players": {
          ".read": "auth != null",
          "$pid": {
            ".write": "auth != null && auth.uid === $pid && newData.exists() && (data.exists() || root.child('rooms/' + $code + '/meta/status').val() === 'lobby')",
            ".validate": "$pid.length <= 128 && $pid.matches(/^[A-Za-z0-9_-]+$/) && newData.hasChildren(['name', 'ready', 'connected', 'alive']) && (data.exists() || (auth != null && auth.uid === root.child('rooms/' + $code + '/meta/hostId').val()) || (newData.child('alive').val() === true && newData.child('connected').val() === true && newData.child('ready').val() === false))",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24 && ((auth != null && auth.uid === root.child('rooms/' + $code + '/meta/hostId').val()) || data.val() === newData.val() || root.child('rooms/' + $code + '/meta/status').val() === 'lobby')"
            },
            "ready": {
              ".validate": "newData.isBoolean() && ((auth != null && auth.uid === root.child('rooms/' + $code + '/meta/hostId').val()) || data.val() === newData.val() || root.child('rooms/' + $code + '/meta/status').val() === 'lobby')"
            },
            "connected": {
              ".validate": "newData.isBoolean()"
            },
            "alive": {
              ".validate": "newData.isBoolean() && ((auth != null && auth.uid === root.child('rooms/' + $code + '/meta/hostId').val()) || data.val() === newData.val() || (!data.exists() && newData.val() === true))"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "cards": {
          ".read": "auth != null && auth.uid === root.child('rooms/' + $code + '/meta/hostId').val()",
          "$pid": {
            ".read": "auth != null && (auth.uid === $pid || auth.uid === root.child('rooms/' + $code + '/meta/hostId').val())",
            ".validate": "$pid.length <= 128 && $pid.matches(/^[A-Za-z0-9_-]+$/) && newData.hasChildren(['role'])",
            "role": {
              ".validate": "newData.isString() && (newData.val() === 'werewolf' || newData.val() === 'villager' || newData.val() === 'seer' || newData.val() === 'witch' || newData.val() === 'hunter' || newData.val() === 'cupid' || newData.val() === 'little-girl' || newData.val() === 'thief')"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "spares": {
          ".read": "auth != null && auth.uid === root.child('rooms/' + $code + '/meta/hostId').val()",
          "$i": {
            ".validate": "$i.length <= 2 && $i.matches(/^[0-9]+$/) && newData.isString() && (newData.val() === 'werewolf' || newData.val() === 'villager' || newData.val() === 'seer' || newData.val() === 'witch' || newData.val() === 'hunter' || newData.val() === 'cupid' || newData.val() === 'little-girl' || newData.val() === 'thief')"
          }
        },
        "sheriff": {
          ".read": "auth != null",
          ".validate": "newData.isString() && newData.val().length <= 128 && newData.val().matches(/^[A-Za-z0-9_-]+$/)"
        },
        "night": {
          ".read": "auth != null && auth.uid === root.child('rooms/' + $code + '/meta/hostId').val()",
          "locked": {
            ".validate": "newData.isBoolean()"
          },
          "killed": {
            "$pid": {
              ".validate": "$pid.length <= 128 && $pid.matches(/^[A-Za-z0-9_-]+$/) && newData.val() === true"
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "events": {
          ".read": "auth != null && auth.uid === root.child('rooms/' + $code + '/meta/hostId').val()",
          "$pid": {
            ".read": "auth != null && (auth.uid === $pid || auth.uid === root.child('rooms/' + $code + '/meta/hostId').val())",
            ".validate": "$pid.length <= 128 && $pid.matches(/^[A-Za-z0-9_-]+$/) && newData.hasChildren(['killedAt'])",
            "killedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
