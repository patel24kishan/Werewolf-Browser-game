{
  "name": "werewolf-companion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-card-art.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-card-art.mjs",
    "build": "next build",
    "build:memory": "node scripts/build-memory.mjs",
    "test": "vitest run",
    "test:integration": "playwright test",
    "test:live": "vitest run --config vitest.live.config.ts",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "deploy:check": "node scripts/check-deploy.mjs",
    "deploy": "npm run build && npm run deploy:check && npx --yes firebase-tools@15.37.0 deploy --only hosting,database"
  },
  "dependencies": {
    "firebase": "13.4.0",
    "jsqr": "1.4.0",
    "next": "16.4.6",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "vitest": "5.1.2"
  }
}
